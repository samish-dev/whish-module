{
  "name": "whish-payment",
  "version": "1.0.2",
  "description": "The Whish Payment Node library provides convenient access to the Whish Money API from applications written in server-side JavaScript.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "clean": "rm -rf dist",
    "prepublish": "npm run build",
    "preversion": "npm test",
    "version": "npm run build && git add --force dist && git add package.json",
    "postversion": "git push && git push --tags && npm run clean",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samish-dev/whish-module.git"
  },
  "keywords": [
    "whish",
    "api",
    "payment processing",
    "credit cards"
  ],
  "author": "Sami Shames El Deen",
  "contributers": [
    "Sami Sh (https://github.com/samish-dev)"
  ],
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "release-it": "^18.1.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "relese-it": {
    "git": {
      "commitMessage": "chore(release): v${version}",
      "push": true,
      "commit": true,
      "tag": true,
      "requireCommits": false,
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true,
      "draft": true
    }
  }
}
