{
  "name": "whish-payment",
  "version": "1.0.3",
  "description": "The Whish Payment Node.js SDK provides convenient access to the Whish Money API for payment processing, balance checking, and transaction management.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "docs": "typedoc src/index.ts --out docs/api",
    "validate": "npm run lint:check && npm run format:check && npm run test:ci",
    "prepublishOnly": "npm run validate && npm run build",
    "preversion": "npm run validate",
    "version": "npm run build && git add dist",
    "postversion": "git push && git push --tags",
    "release": "release-it",
    "dev": "npm run build:watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samish-dev/whish-module.git"
  },
  "keywords": [
    "whish",
    "payment",
    "api",
    "payment-processing",
    "fintech",
    "nodejs",
    "typescript",
    "sdk",
    "money-transfer",
    "digital-payments",
    "lebanon",
    "middle-east"
  ],
  "author": {
    "name": "Sami Shames El Deen",
    "email": "sami@example.com",
    "url": "https://github.com/samish-dev"
  },
  "contributors": [
    {
      "name": "Sami Sh",
      "url": "https://github.com/samish-dev"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samish-dev/whish-module/issues"
  },
  "homepage": "https://github.com/samish-dev/whish-module#readme",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "release-it": "^18.1.2",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.25.12",
    "typescript": "^5.7.3"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): v${version}",
      "push": true,
      "commit": true,
      "tag": true,
      "requireCommits": false,
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true,
      "draft": true
    },
    "npm": {
      "publish": true
    }
  }
}
